<?xml version="1.0"?>
<package format="3">
  <name>nav_worlds</name>
  <version>0.1.0</version>
  <description>
    Point-to-point navigation with SLAM and Nav2 for the Clearpath a200 and the
    Unitree go1, across the Gazebo worlds shipped with clearpath_gz plus depot.
  </description>
  <maintainer email="nicklausw2006@gmail.com">nick</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>clearpath_gz</exec_depend>
  <exec_depend>clearpath_nav2_demos</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>nav2_simple_commander</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
