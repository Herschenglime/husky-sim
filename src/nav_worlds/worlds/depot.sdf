<?xml version="1.0"?>
<!--
  Depot world for navigation.

  clearpath_gz ships warehouse, office, construction, orchard, pipeline and
  solar_farm but no depot, so this one is carried here. It is based on the copy
  in turtlebot4_gz_bringup, with two changes that matter:

    * The Sensors system is ENABLED. In the original it is commented out, which
      is silently fatal here: with no Sensors system the 2D lidar publishes
      nothing at all, so SLAM builds no map and Nav2 has nothing to plan on.
    * The Imu system is added, which robot_localization's EKF needs to produce
      odom -> base_link.

  The Depot model itself comes from Fuel and is already cached locally.
-->
<sdf version="1.6">
  <world name="depot">
    <scene>
      <ambient>0.9 0.9 0.9 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <grid>false</grid>
    </scene>

    <physics name="1ms" type="ignored">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system"/>

    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.3 0.3 -1</direction>
    </light>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Depot</uri>
    </include>
  </world>
</sdf>
