    <include>
      <uri>
      https://fuel.gazebosim.org/1.0/OpenRobotics/models/MaleVisitorOnPhone
      </uri>
      <name>Person 1 - Standing</name>
      <pose>1 -1 0 0 0 1.57</pose>
    </include>

    <include>
      <uri>
      https://fuel.gazebosim.org/1.0/plateau/models/Casual female
      </uri>
      <name>Person 2 - Walking</name>
      <pose>-12 15 0 0 0 0</pose>
    </include>

    <!-- Line-following track.

         Visual only (no collision) and 1 cm above the warehouse floor, so it
         cannot collide with anything and cannot z-fight the floor mesh. The
         quad spans the floor exactly - x [-15, 15], y [-25, 25] - matching the
         1006 x 1674 px drawing at 0.0298 m/px, which is the scale it was drawn
         at. Painted width is 0.15 m.

         Clearance to the existing props was checked against this layout: the
         nearest is barrier_2 at 1.39 m from the painted line, so a 0.99 m wide
         Husky tracking the line stays clear of every shelf, barrier and chair.
    -->
    <include>
      <uri>model://line_track</uri>
      <name>line_track</name>
      <pose>0 0 0.01 0 0 0</pose>
    </include>


    <!-- OBSTACLE COURSE (generated by place_obstacles.py) -->
    <model name='obstacle_0'>
      <static>true</static>
      <pose>-5.099 14.486 0.350 0 0 0.0000</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>0.5 0.5 0.7</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>0.5 0.5 0.7</size></box></geometry>
          <material>
            <!-- Red on purpose: the follower thresholds yellow at OpenCV hue
                 18-38 and red sits at hue 0, so a box is never seen as track. -->
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>
