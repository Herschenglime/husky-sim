# Floor decal quad for the warehouse line track.
# GENERATED by gen_track_texture.py - do not edit; change FLOOR_X_M/FLOOR_Y_M
# there and regenerate, so the mesh and the texture scale stay in agreement.
#
# Spans the warehouse floor exactly: x [-15, 15], y [-25, 25], z = 0.
# UVs are written out explicitly rather than relying on <plane>'s implicit
# mapping, so the texture lands on the floor at a known scale and orientation:
# u = 0 at x = -15 (image column 0), v = 1 at y = 25 (image row 0, top).
mtllib track_plane.mtl
o track_plane
v -15.0 -25.0 0.0
v  15.0 -25.0 0.0
v  15.0  25.0 0.0
v -15.0  25.0 0.0
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
vn 0.0 0.0 1.0
usemtl track
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
