<?xml version="1.0"?>
<model>
  <name>line_track</name>
  <version>1.0</version>
  <sdf version="1.7">model.sdf</sdf>
  <description>
    Bright yellow line-following track painted on the warehouse floor.
    Visual only - no collision geometry - and offset above the floor so it
    never z-fights the warehouse mesh.
  </description>
</model>
