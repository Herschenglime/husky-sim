<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>line_follower</name>
  <version>0.1.0</version>
  <description>
    OpenCV camera line follower for the painted warehouse track in line_follow_sim.
  </description>
  <maintainer email="nicklausw2006@gmail.com">nick</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <!-- odometry yaw, used to bound the obstacle detour's return -->
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>line_follow_sim</exec_depend>
  <!-- run_scored_test.sh polls controller_manager's list_controllers service. -->
  <exec_depend>controller_manager_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
